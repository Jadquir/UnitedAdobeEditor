<local:ExtendedUserControl
    x:Class="UnitedAdobeEditor.Views.CustomControls.AppSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnitedAdobeEditor.Views.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="Montserrat"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid
        Name="grid"
        Margin="2"
        Cursor="Hand">

        <!--  Hover Animations  -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="scaleAnimation"
                            Storyboard.TargetProperty="ScaleX"
                            To="1.1"
                            Duration="0:0:0.2" />
                        <DoubleAnimation
                            Storyboard.TargetName="scaleAnimation"
                            Storyboard.TargetProperty="ScaleY"
                            To="1.1"
                            Duration="0:0:0.2" />
                        <ColorAnimation
                            Storyboard.TargetName="shadow"
                            Storyboard.TargetProperty="Color"
                            To="#FF3C9DFF"
                            Duration="0:0:0.2" />
                        <DoubleAnimation
                            Storyboard.TargetName="shadow"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.2" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <EventTrigger RoutedEvent="Grid.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="scaleAnimation"
                            Storyboard.TargetProperty="ScaleX"
                            To="1.0"
                            Duration="0:0:0.2" />
                        <DoubleAnimation
                            Storyboard.TargetName="scaleAnimation"
                            Storyboard.TargetProperty="ScaleY"
                            To="1.0"
                            Duration="0:0:0.2" />
                        <ColorAnimation
                            Storyboard.TargetName="shadow"
                            Storyboard.TargetProperty="Color"
                            To="#0A000000"
                            Duration="0:0:0.2" />
                        <DoubleAnimation
                            Storyboard.TargetName="shadow"
                            Storyboard.TargetProperty="Opacity"
                            To="0.4"
                            Duration="0:0:0.2" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!--  Transform + Shadow  -->
        <Grid.RenderTransform>
            <ScaleTransform x:Name="scaleAnimation" CenterX="75" CenterY="90" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.Effect>
            <DropShadowEffect
                x:Name="shadow"
                BlurRadius="20"
                Opacity="0.4"
                ShadowDepth="0"
                Color="#0A000000" />
        </Grid.Effect>

        <!--  Card with Transparent + Blur  -->
        <Border
            Width="160"
            Height="200"
            Margin="1"
            Padding="16"
            Background="#00ffffff"
            BorderThickness="1">

            <StackPanel VerticalAlignment="Stretch">
                <!--  Logo  -->
                <Image
                    x:Name="AppLogo"
                    Grid.Row="0"
                    Width="108"
                    Height="108"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Stretch="Uniform" />

                <!--  App Name  -->
                <TextBlock
                    x:Name="AppName"
                    Grid.Row="1"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    FontSize="17"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Photoshop"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</local:ExtendedUserControl>
