<Page
    x:Class="UnitedAdobeEditor.Views.Pages.SplashScreenChanger"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UnitedAdobeEditor="clr-namespace:UnitedAdobeEditor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnitedAdobeEditor.Views.Pages"
    xmlns:local1="clr-namespace:UnitedAdobeEditor.Views.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SplashScreenChanger"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="Montserrat"
    FontSize="15"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="True"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.VerticalScrollBarVisibility="Visible"
    mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <!--<local1:ExtendedBorder
                x:Name="imageHolder"
                Height="300"
                Margin="15"
                HorizontalAlignment="Center"
                Background="{StaticResource threBrush}"
                CornerRadius="10"
                Cursor="Hand">
                <local1:ExtendedBorder.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetName="shadow"
                                    Storyboard.TargetProperty="(Color)"
                                    From="{StaticResource shadowColor}"
                                    To="{StaticResource hoverColor}"
                                    Duration="0:0:0.15">

                                    <ColorAnimation.EasingFunction>
                                        <BounceEase
                                            Bounces="2"
                                            Bounciness="2"
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetName="shadow"
                                    Storyboard.TargetProperty="(Color)"
                                    From="{StaticResource hoverColor}"
                                    To="{StaticResource shadowColor}"
                                    Duration="0:0:0.15">

                                    <ColorAnimation.EasingFunction>
                                        <BounceEase
                                            Bounces="2"
                                            Bounciness="2"
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </local1:ExtendedBorder.Triggers>
                <local1:ExtendedBorder.Effect>
                    <DropShadowEffect
                        x:Name="shadow"
                        BlurRadius="13"
                        ShadowDepth="0"
                        Color="{StaticResource shadowColor}" />
                </local1:ExtendedBorder.Effect>
                <Image x:Name="image" Source="/Images/SplashScreenImport.png" />
            </local1:ExtendedBorder>
            <local1:ExtendedBorder
                HorizontalAlignment="Center"
                Background="{StaticResource threBrush}"
                CornerRadius="5"
                Cursor="Hand"
                EnableChangeBgColor="True">
                <local1:ExtendedBorder.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetName="shadow"
                                    Storyboard.TargetProperty="(Color)"
                                    From="{StaticResource shadowColor}"
                                    To="{StaticResource hoverColor}"
                                    Duration="0:0:0.15">

                                    <ColorAnimation.EasingFunction>
                                        <BounceEase
                                            Bounces="2"
                                            Bounciness="2"
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetName="shadow"
                                    Storyboard.TargetProperty="(Color)"
                                    From="{StaticResource hoverColor}"
                                    To="{StaticResource shadowColor}"
                                    Duration="0:0:0.15">

                                    <ColorAnimation.EasingFunction>
                                        <BounceEase
                                            Bounces="2"
                                            Bounciness="2"
                                            EasingMode="EaseInOut" />
                                    </ColorAnimation.EasingFunction>
                                </ColorAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </local1:ExtendedBorder.Triggers>
                <local1:ExtendedBorder.Effect>
                    <DropShadowEffect
                        BlurRadius="13"
                        ShadowDepth="0"
                        Color="{StaticResource shadowColor}" />
                </local1:ExtendedBorder.Effect>
                <ui:Hyperlink
                    Padding="12,7"
                    Content="Don't you have a custom splash screen? Create one easily."
                    NavigateUri="{Binding Instance.CreateSplashScreenLink, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UnitedAdobeEditor:MainWindow}}}" />
            </local1:ExtendedBorder>-->


            <StackPanel
                x:Name="darkModeAlternativePanel"
                Grid.Row="1"
                HorizontalAlignment="Center">
                <Border
                    Height="1"
                    Margin="50,15"
                    Background="Transparent"
                    Opacity=".2" />
                <TextBlock
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold">
                    Choose Splash Screen Replacement Mode
                </TextBlock>

                <TextBlock
                    Margin="0,5,0,15"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="Gray"
                    Text="Some Adobe apps have separate dark and light splash screens. Pick how you want them replaced."
                    TextAlignment="Center" />

                <ComboBox
                    x:Name="darkModeAlternativeSelect"
                    Width="370"
                    Cursor="Hand"
                    SelectedIndex="0"
                    SelectionChanged="darkModeAlternativeSelect_SelectionChanged">
                    <ComboBoxItem>Replace Both Dark and Light Splash Screens</ComboBoxItem>
                    <ComboBoxItem>Replace Only Dark Splash Screen</ComboBoxItem>
                    <ComboBoxItem>Replace Only Light Splash Screen</ComboBoxItem>
                </ComboBox>

                <Border
                    Height="1"
                    Margin="50,15,0,0"
                    Background="White"
                    Opacity=".2" />
            </StackPanel>

            <StackPanel>

                <TextBlock
                    Margin="0,20,0,15"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold">
                    Choose Your Custom Splash Screen
                </TextBlock>

                <local1:ImageSelector x:Name="imageSelector" />
            </StackPanel>


            <TextBlock
                x:Name="colorboxesText"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold">
                Choose the custom colors
            </TextBlock>
            <StackPanel
                x:Name="colorboxes"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                Cursor="Hand"
                Orientation="Horizontal"
                Visibility="Collapsed" />

            <Grid
                Margin="20,20,0,35"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    x:Name="applyButton"
                    Grid.Column="0"
                    Width="190"
                    Padding="50,10"
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Click="applyButton_Click"
                    Content="Apply"
                    CornerRadius="18,0,0,18"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Save24}" />
                <ui:Button
                    x:Name="restoreButton"
                    Grid.Column="1"
                    Width="190"
                    Padding="20,10"
                    HorizontalAlignment="Left"
                    Click="restoreButton_Click"
                    Content="Return to Original"
                    CornerRadius="0,18,18,0"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon ArrowCounterclockwise12}" />
            </Grid>

        </StackPanel>


    </Grid>
</Page>
