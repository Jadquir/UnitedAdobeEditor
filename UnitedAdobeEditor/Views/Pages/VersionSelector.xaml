<Page
    x:Class="UnitedAdobeEditor.Views.Pages.VersionSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UnitedAdobeEditor.Views.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnitedAdobeEditor.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="VersionSelector"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="Montserrat"
    FontSize="15"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock
                Margin="0,25,0,25"
                VerticalAlignment="Top"
                FontSize="16"
                FontWeight="SemiBold"
                TextAlignment="Center">
                Please select the path of the application.
            </TextBlock>
            <Border
                Height="1"
                Margin="0,0"
                VerticalAlignment="Bottom"
                Background="White"
                Opacity=".1" />
            <controls:AppSelectionItem
                x:Name="appLogo"
                Margin="0,12"
                HorizontalAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:ProgressRing
                    x:Name="loadingRing"
                    Width="30"
                    Height="30"
                    Margin="0,0,10,0"
                    IsIndeterminate="True" />
                <ui:Button
                    Click="Button_Click"
                    Content="Add Version"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Add12}" />
            </StackPanel>
            <Border
                Height="1"
                Margin="100,20,100,0"
                VerticalAlignment="Bottom"
                Background="White"
                Opacity=".1" />
            <Grid>
                <ui:VirtualizingItemsControl
                    x:Name="list1"
                    Grid.Row="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Top"
                    VirtualizingPanel.CacheLengthUnit="Pixel"
                    VirtualizingPanel.IsContainerVirtualizable="True"
                    VirtualizingPanel.IsVirtualizing="True" />
                <TextBlock
                    x:Name="emptyText"
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="No versions found yet. Add a version to get started." />
            </Grid>

        </StackPanel>

    </Grid>
</Page>
