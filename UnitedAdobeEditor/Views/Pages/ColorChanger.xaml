<Page
    x:Class="UnitedAdobeEditor.Views.Pages.ColorChanger"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customcontrols="clr-namespace:UnitedAdobeEditor.Views.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnitedAdobeEditor.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ColorChanger"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="Montserrat"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
        <StackPanel
            Margin="0,40,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Orientation="Vertical">
            <ui:TextBlock
                VerticalAlignment="Top"
                FontSize="16"
                FontWeight="SemiBold"
                TextAlignment="Center">
                Please select a color.
            </ui:TextBlock>
            <customcontrols:ExtendedBorder
                x:Name="mainColorHolder"
                Width="120"
                Height="90"
                Margin="0,15,0,0"
                Background="Red"
                CornerRadius="15"
                Cursor="Hand" />

            <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                <CheckBox
                    x:Name="advancedActiveCheckBox"
                    Margin="0,0,10,0"
                    Checked="CheckBox_Checked"
                    FontSize="13"
                    Unchecked="CheckBox_Checked">
                    Advanced Color Selection Mode
                </CheckBox>
                <ui:Button
                    x:Name="advancedEditButton"
                    Click="advancedEditButton_Click"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Edit16}">
                    Edit
                </ui:Button>
            </StackPanel>
            <StackPanel Margin="0,25,0,0" Orientation="Vertical">

                <ui:TextBlock
                    VerticalAlignment="Top"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextAlignment="Center">
                    Select your Photoshop Theme
                </ui:TextBlock>
                <ComboBox x:Name="photoshopThemeComboBox" Margin="30,10,30,0" />
            </StackPanel>
            <Grid
                Margin="20,20,0,35"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    x:Name="applyButton"
                    Grid.Column="0"
                    Width="190"
                    Padding="50,10"
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Click="applyButton_Click"
                    Content="Apply"
                    CornerRadius="18,0,0,18"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Save24}" />
                <ui:Button
                    x:Name="restoreButton"
                    Grid.Column="1"
                    Width="190"
                    Padding="20,10"
                    HorizontalAlignment="Left"
                    Click="restoreButton_Click"
                    Content="Return to Original"
                    CornerRadius="0,18,18,0"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon ArrowCounterclockwise12}" />
            </Grid>

        </StackPanel>
    </Grid>

</Page>
