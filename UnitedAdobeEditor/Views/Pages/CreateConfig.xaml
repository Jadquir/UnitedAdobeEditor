<Page
    x:Class="UnitedAdobeEditor.Views.Pages.CreateConfig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UnitedAdobeEditor.Views.Pages"
    xmlns:local1="clr-namespace:UnitedAdobeEditor.Views.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CreateConfig"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,10">

            <TextBlock
                VerticalAlignment="Top"
                FontSize="16"
                FontWeight="SemiBold"
                TextAlignment="Center">
                You can create custom config files and use it or share it with your friends
            </TextBlock>
            <Border
                Height="1"
                Margin="0,10"
                VerticalAlignment="Bottom"
                Background="White"
                Opacity=".1" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock
                    Margin="0,00,0,15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextAlignment="Center">
                    First select the application
                </TextBlock>
                <ComboBox
                    x:Name="apps"
                    Width="250"
                    Cursor="Hand" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,30,0,0">
                <TextBlock
                    Margin="0,00,0,15"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    Choose Your Custom Splash Screen
                </TextBlock>
                <local1:ImageSelector x:Name="imageSelector" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,10">
                <TextBlock
                    Margin="0,20,0,15"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold">
                    Other Settings
                </TextBlock>
                <StackPanel
                    x:Name="runWithSelectedPathPanel"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox x:Name="enableSelectedPath" Margin="0,0,10,0">Run with Selected Path</CheckBox>
                    <ui:Button
                        Click="SelectPath"
                        Icon="{ui:SymbolIcon Folder20}"
                        IsEnabled="{Binding IsChecked, ElementName=enableSelectedPath}">
                        Select Path
                    </ui:Button>
                </StackPanel>
                <TextBlock
                    x:Name="selectedPathText"
                    Margin="0,7,0,10"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                    Selected Path:
                </TextBlock>
                <CheckBox x:Name="runSilentCheckBox" HorizontalAlignment="Center">Run Silent (This will hide the application while changing the Splash Screen)</CheckBox>
                <CheckBox x:Name="closeAfterChanging" HorizontalAlignment="Center">Close UAE after changing the splash screen</CheckBox>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,10,0,50">
            <ui:Button
                Padding="30,10"
                HorizontalAlignment="Center"
                Appearance="Primary"
                Click="CreateClick"
                CornerRadius="20"
                Cursor="Hand"
                Icon="{ui:SymbolIcon Save16,
                                     FontSize=20}"
                TextBlock.FontWeight="SemiBold">
                Save Config
            </ui:Button>
        </StackPanel>
    </Grid>
</Page>
